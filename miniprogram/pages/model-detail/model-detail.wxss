.page {
  padding: 24rpx 24rpx 180rpx;
  box-sizing: border-box;
}

.detail-img {
  height: 440rpx;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.detail-img.placeholder {
  background: #e8eef4;
  flex-direction: column;
}
.detail-photo {
  width: 100%;
  height: 100%;
}
.emoji {
  font-size: 140rpx;
}
.cap {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #999;
}

.thumbs {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}
.thumb {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  background: #e8eef4;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.thumb.active {
  outline: 4rpx solid #ff6b35;
}
.thumb-photo {
  width: 100%;
  height: 100%;
}
.thumb-emoji {
  font-size: 44rpx;
}
.thumb-label {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  color: #ffffff;
  font-size: 16rpx;
  text-align: center;
  line-height: 1.4;
  padding: 2rpx 0;
}

.title {
  margin-top: 24rpx;
  padding: 28rpx 32rpx;
}
.name {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.5;
}
.price-line {
  margin-top: 16rpx;
  display: flex;
  align-items: baseline;
}
.price {
  font-size: 40rpx;
  font-weight: 700;
  color: #ff5f3d;
}
.price-tip {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #999;
}

.specs {
  margin-top: 24rpx;
  padding: 28rpx 32rpx;
}
.specs-title,
.desc-title {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}
.spec-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.spec {
  width: calc(50% - 8rpx);
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}
.spec .k {
  font-size: 20rpx;
  color: #999;
}
.spec .v {
  margin-top: 4rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.desc {
  margin-top: 24rpx;
  padding: 28rpx 32rpx;
}
.desc-text {
  font-size: 24rpx;
  color: #666;
  line-height: 1.8;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-top: 1rpx solid #eee;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  z-index: 10;
}
.bar-price {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.bar-tip {
  font-size: 20rpx;
  color: #999;
}
.view-plan {
  flex-shrink: 0;
}
.choose {
  flex: 1.4;
  padding: 18rpx 0;
  font-size: 28rpx;
}
.choose.chosen {
  background: #ffb08a;
}
