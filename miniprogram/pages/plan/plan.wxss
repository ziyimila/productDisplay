.page {
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

.head {
  padding: 28rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.head-title {
  font-size: 32rpx;
  font-weight: 700;
}
.head-sub {
  font-size: 24rpx;
  color: #ff6b35;
}

/* ---------- 面积 + 户型 ---------- */
.layout {
  margin-top: 24rpx;
  padding: 24rpx 32rpx;
}
.layout-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.layout-label {
  font-size: 26rpx;
  color: #666;
  flex-shrink: 0;
}
.area-input {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  border: 1rpx solid #e0e3e8;
  border-radius: 12rpx;
  padding: 10rpx 20rpx;
}
.area-input input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
}
.unit {
  font-size: 24rpx;
  color: #999;
}
.layout-std {
  font-size: 20rpx;
  color: #999;
  flex-shrink: 0;
}

.room-row {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.room-label {
  width: 120rpx;
  font-size: 26rpx;
  font-weight: 600;
}
.room-std-count {
  flex: 1;
  font-size: 20rpx;
  color: #999;
}
.stepper {
  display: flex;
  align-items: center;
  gap: 24rpx;
  border: 1rpx solid #e0e3e8;
  border-radius: 12rpx;
  padding: 6rpx 20rpx;
}
.step-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #f5f6f8;
  border: 1rpx solid #e6e8eb;
  color: #ff6b35;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.step-count {
  min-width: 40rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
}
.stepper-fixed {
  background: #f7f8fa;
}
.fixed-tip {
  font-size: 20rpx;
  color: #999;
}

.room-over {
  width: 130rpx;
  text-align: right;
  font-size: 20rpx;
  color: #bbb;
}
.room-over.on {
  color: #ff6b35;
  font-weight: 600;
}

.layout-tip {
  margin-top: 20rpx;
  font-size: 20rpx;
  color: #999;
  line-height: 1.6;
}

/* ---------- 已选材质 ---------- */
.section-title {
  margin: 32rpx 8rpx 0;
  font-size: 28rpx;
  font-weight: 700;
}

.line {
  margin-top: 20rpx;
  padding: 24rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.line-left {
  flex: 1;
  overflow: hidden;
}
.category {
  font-size: 26rpx;
  font-weight: 700;
}
.model {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #666;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.line-include {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #1a9e4b;
}
.line-right {
  text-align: right;
  margin-left: 20rpx;
}
.line-arrow {
  color: #ccc;
  font-size: 32rpx;
  margin-left: 8rpx;
}
.p {
  font-size: 28rpx;
  font-weight: 700;
}

/* ---------- 费用明细 ---------- */
.total {
  margin-top: 20rpx;
  padding: 24rpx 32rpx;
}
.total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 24rpx;
  color: #666;
  padding: 10rpx 0;
}
.total-row text:last-child {
  text-align: right;
  margin-left: 20rpx;
}
.total-row.big {
  margin-top: 12rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed #e0e3e8;
  font-size: 34rpx;
  font-weight: 700;
  color: #ff5f3d;
}

/* ---------- 操作 ---------- */
.actions {
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.actions .btn-ghost {
  flex-shrink: 0;
  padding: 18rpx 36rpx;
}
.actions .btn-primary {
  flex: 1;
}

.tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 20rpx;
  color: #aaa;
}
