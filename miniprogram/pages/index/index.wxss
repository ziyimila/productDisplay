.page {
  padding-bottom: 40rpx;
}

.banner {
  margin: 24rpx;
  padding: 36rpx 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #ff8a3d, #ff5f6d);
  color: #ffffff;
}
.banner-title {
  font-size: 40rpx;
  font-weight: 700;
}
.banner-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.92;
}

.pkg-card {
  position: relative;
  margin: 0 24rpx 24rpx;
  padding: 32rpx;
}
.pkg-card.hot {
  border: 2rpx solid #ff6b35;
}
.hot-badge {
  position: absolute;
  top: -18rpx;
  right: 24rpx;
  background: #ff6b35;
  color: #ffffff;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

.pkg-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.pkg-name {
  font-size: 34rpx;
  font-weight: 700;
}
.pkg-tag {
  margin-left: 12rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: #ff6b35;
  background: #fff3e8;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  vertical-align: 4rpx;
}
.pkg-price {
  font-size: 40rpx;
  font-weight: 700;
  color: #ff5f3d;
}
.pkg-price .unit {
  font-size: 22rpx;
  font-weight: 400;
  color: #999;
}

.pkg-note {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #888;
}
.price-note {
  color: #ff6b35;
}
.room-note {
  color: #333;
}

.chips {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.chip {
  background: #f5f6f8;
  border: 1rpx solid #e6e8eb;
  border-radius: 10rpx;
  padding: 4rpx 16rpx;
  font-size: 22rpx;
  color: #444;
}

.brand-line {
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #888;
}

.pkg-materials {
  margin-top: 20rpx;
  background: #fafbfc;
  border: 1rpx solid #eef0f3;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}
.mat-title {
  font-size: 20rpx;
  font-weight: 600;
  color: #999;
  margin-bottom: 10rpx;
}
.mat-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx 24rpx;
}
.mat-item {
  display: flex;
  align-items: baseline;
  font-size: 22rpx;
}
.mat-label {
  color: #999;
  margin-right: 8rpx;
  flex-shrink: 0;
}
.mat-value {
  color: #333;
  font-weight: 600;
}

.footer-tip {
  text-align: center;
  font-size: 22rpx;
  color: #aaa;
  margin-top: 8rpx;
}
